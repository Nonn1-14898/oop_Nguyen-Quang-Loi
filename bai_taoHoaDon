class HH{
		string tenHH;
		int maHH;
		int sl;
		int donGia;
		string donVi;
	public:
		HH();
		void nhap();
		void in();
		float tinhTien();
};
HH::HH(){
	tenHH="";
	maHH=0;
	sl=0;
	donGia=0;
	donVi="";
}
void HH::nhap(){
	cout<<"Nhap ten hang hoa: ";
	getline(cin,tenHH);
	cout<<"Nhap ma hang hoa: ";
	cin>>maHH;
	cout<<"Nhap so luong hang hoa: ";
	cin>>sl;
	cout<<"Nhap don gia: ";
	cin>>donGia;
	cout<<"Nhap don vi tinh: ";
	cin>>donVi;
	cin.ignore();
}
void HH::in(){
	cout<<"Ten hang hoa: "<<tenHH;
	cout<<" Ma hang hoa: "<<maHH;
	cout<<" So luong hang hoa: "<<sl;
	cout<<" Don gia: "<<donGia;
	cout<<" Don vi tinh: "<<donVi;
	cout<<" Thanh tien: "<<tinhTien()<<endl;
}
float HH::tinhTien(){
	return donGia*sl;
}

class HoaDon{
		CCH x;
		KH y;
		int slHH;
		HH *a;
	public:
		HoaDon();
		void nhap();
		void in();
		int tongTien();
};
HoaDon::HoaDon(){
	a=NULL;
	slHH=0;
}
void HoaDon::nhap(){
	cout<<"Nhap hoa don."<<endl;
	x.nhap();
	y.nhap();
	cout<<"Nhap so luong hang hoa: ";
	cin>>slHH;
	cin.ignore();
	a=new HH[slHH];
	for(int i=0;i<slHH;i++){
		cout<<"\nHang hoa "<<i+1<<endl;
		a[i].nhap();
	}
}
int HoaDon::tongTien(){
	int tong=0;
	for(int i=0;i<slHH;i++){
		tong +=a[i].tinhTien();
	}
	return tong;
}
void HoaDon::in(){
	cout<<"\nHoa don"<<endl;
	cout<<"Thong tin chu cua hang"<<endl;
	x.in();
	cout<<"Thong tin khach hang"<<endl;
	y.in();
	cout<<"Thong tin hang hoa"<<endl;
	for(int i=0;i<slHH;i++){
		a[i].in();
	}
	cout<<"Tong tien: "<<tongTien()<<endl;
}

int main(){
	HoaDon h1;
	h1.nhap();
	h1.in();
	return 0;
}
