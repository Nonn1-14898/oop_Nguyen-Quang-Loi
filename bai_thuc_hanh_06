#include <iostream>
#include <string>
#include <iomanip>
#include <limits>
using namespace std;
class MatHang{
	string maMatHang;
	string tenHang;
	double donGia;
	int soLuong;
	public:
		MatHang(){
			maMatHang="";
			tenHang="";
			donGia=0.0;
			soLuong=0;
		}
		void nhap(){
			cout<<"Nhap ma mat hang: ";
			getline(cin,maMatHang);
			cout<<"Nhap ten mat hang: ";
			getline(cin,tenHang);
			cout<<"Nhan don gia: ";
			cin>>donGia;
			cout<<"Nhap so luong: ";
			cin>>soLuong;
			cin.ignore();
		}
		void xuat(){
			cout << left << setw(15) << maMatHang
             << setw(20) << tenHang
             << setw(15) << soLuong
             << setw(15) << donGia
             << setw(15) << thanhTien() << endl;
		}
		double thanhTien(){
			return donGia*soLuong;
		}
};
