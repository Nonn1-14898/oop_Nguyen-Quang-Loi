class HoaDon{
	string maHoaDon,ngayLap;
	KhachHang *KH;
	NguoiBan *NB;
	MatHang *DSMH;
	int slMH;
	public:
		HoaDon(){
			maHoaDon="";
			ngayLap="";
			KH=new KhachHang;
			NB=new NguoiBan;
			DSMH=NULL;
			slMH=0;
		}
		void nhap() {
        	cout << "\n===== NHAP HOA DON =====\n";	
	        cout << "Nhap ma hoa don: ";
	        getline(cin, maHoaDon);
	
	        cout << "Nhap ngay lap: ";
	        getline(cin, ngayLap);
	
	        cout << "\n===== THONG TIN KHACH HANG =====\n";
	        KH->nhap();
	
	        cout << "\n===== THONG TIN NGUOI BAN =====\n";
	        NB->nhap();
	
	        cout << "\nNhap so luong mat hang: ";
	        cin >> slMH;
	        cin.ignore();
	
	        DSMH = new MatHang[slMH];
	
	        for (int i = 0; i < slMH; i++) {
	            cout << "\nNhap mat hang thu " << i + 1 << endl;
	            DSMH[i].nhap();
	        }
	    }
	
	    double tongTien() {
	        double tong = 0;
	
	        for (int i = 0; i < slMH; i++) {
	            tong += DSMH[i].thanhTien();
	        }
	
	        return tong;
	    }
	
		void xuat() {
	        cout << "\n========== HOA DON ==========\n";
	
	        cout << "Ma hoa don: " << maHoaDon << endl;
	        cout << "Ngay lap: " << ngayLap << endl;
	
	        cout << "\n===== THONG TIN KHACH HANG =====\n";
	        KH->xuat();
	
	        cout << "\n===== THONG TIN NGUOI BAN =====\n";
	        NB->xuat();
	
	        cout << "\n===== DANH SACH MAT HANG =====\n";
	
	        cout << left << setw(15) << "Ma mat hang"
	             << setw(20) << "Ten hang"
	             << setw(15) << "So luong"
	             << setw(15) << "Don gia"
	             << setw(15) << "Thanh tien" << endl;
	
	        for (int i = 0; i < slMH; i++) {
	            DSMH[i].xuat();
	        }
	
	        cout << fixed << setprecision(0);
	
	        cout << "\nTong tien: " << tongTien() << " VND";
	        cout << "\nThue VAT: " << tongTien() * 0.1 << " VND";
	        cout << "\nTong thanh toan: "
	             << tongTien() * 1.1 << " VND";
	
	        cout << "\n==============================\n";
	    }
	
	    ~HoaDon() {
	        delete KH;
	        delete NB;
	        delete[] DSMH;
	    }
};

int main() {
    HoaDon hd;

    hd.nhap();

    cout << "\n\n";
    hd.xuat();

    return 0;
}
